<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <id>Beztek.Facade.Sql</id>
    <version>1.4.0</version>
    <authors>Peter Thomas</authors>
    <owners>Beztek Software Solutions</owners>
    <projectUrl>https://github.com/Beztek-Software-Solutions/sql-facade</projectUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Database-portable SQL facade for .NET based on SQLKata and Dapper</description>
    <releaseNotes>Database-portable SQL facade for .NET based on SQLKata and Dapper</releaseNotes>
    <copyright>Copyright 2023, Beztek Software Solutions</copyright>
    <tags>Beztek.Facade.Sql;sql-facade;SqlFacade</tags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SqlKata" Version="4.0.1" />
    <PackageReference Include="SqlKata.Execution" Version="4.0.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Beztek.Facade.Sql.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
